import Natfunbasis.WilkieBaseRationalClassification
import Natfunbasis.WilkieOneVariableBaseIndependence
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
# The one-variable base-field solution classification

This file packages the first nontrivial `(II)` clause in Wilkie's
one-variable induction.  We first realize `Real(x)` as a differential
intermediate field, identify adjoining `log x` with the already constructed
field `F0 = Real(x, log x)`, and then combine:

* the solution classification in `Real(x)`;
* algebraic independence of `(x, log x)`; and
* Proposition 3.1(ii) in its corrected, explicit-rigidity form.

The final theorem keeps `IntegralSlopeRigidity` as a visible premise.  This
is exactly the additional base-field input needed to obtain the integral
slope claimed in the printed proposition.
-/

open scoped Differential
open Polynomial Set

namespace Natfunbasis.Wilkie.BaseFieldClassification

noncomputable section

local notation "A" => PositiveAnalyticFractionField

/-! ## The derivative-closed field `Real(x)` -/

/-- The differential intermediate field generated by the analytic
coordinate `x`. -/
def realXField : DifferentialIntermediateField Real A :=
  DifferentialIntermediateField.adjoinOfConstants
    ({OneVariableBaseField.x} : Set A)
    PositiveAnalyticFractionField.derivation_algebraMap_real
    (by
      intro y hy
      have hyx : y = OneVariableBaseField.x := by simpa using hy
      subst y
      rw [OneVariableBaseField.deriv_x]
      exact one_mem _)

@[simp]
theorem mem_realXField_iff (y : A) :
    y ∈ realXField ↔
      y ∈ IntermediateField.adjoin Real
        ({OneVariableBaseField.x} : Set A) :=
  Iff.rfl

/-- The coordinate as an element of `Real(x)`. -/
def xGen : realXField :=
  ⟨OneVariableBaseField.x,
    IntermediateField.subset_adjoin Real
      ({OneVariableBaseField.x} : Set A) (by simp)⟩

@[simp]
theorem xGen_coe : (xGen : A) = OneVariableBaseField.x :=
  rfl

@[simp]
theorem deriv_xGen : xGen′ = 1 := by
  apply Subtype.ext
  exact OneVariableBaseField.deriv_x

theorem xGen_ne_zero : xGen ≠ 0 := by
  intro h
  apply OneVariableBaseField.x_ne_zero
  exact congrArg Subtype.val h

/-- The subtype carried by the differential field `realXField` is canonically
the subtype carried by its underlying ordinary intermediate field.  Keeping
this equivalence explicit avoids relying on definitional equality between the
two independently induced field structures. -/
def realXFieldEquivUnderlying :
    IntermediateField.adjoin Real ({OneVariableBaseField.x} : Set A) ≃+*
      realXField where
  toFun y := ⟨y, by simpa [realXField] using y.2⟩
  invFun y := ⟨y, by simpa [realXField] using y.2⟩
  left_inv y := by ext; rfl
  right_inv y := by ext; rfl
  map_add' x y := by ext; rfl
  map_mul' x y := by ext; rfl

@[simp]
theorem realXFieldEquivUnderlying_coe
    (y : IntermediateField.adjoin Real
      ({OneVariableBaseField.x} : Set A)) :
    ((realXFieldEquivUnderlying y : realXField) : A) = (y : A) :=
  rfl

/-- Every ambient constant already lies in `Real(x)`, so this intermediate
field and the ambient analytic fraction field have the same constants. -/
instance realXField_containConstants :
    Differential.ContainConstants realXField A where
  mem_range_of_deriv_eq_zero {y} hy := by
    obtain ⟨c, hc⟩ := mem_range_of_deriv_eq_zero Real hy
    let d : realXField := algebraMap Real realXField c
    refine ⟨d, ?_⟩
    simpa [d] using hc

/-! ## Adjoining `log x` recovers `F0` -/

/-- Adjoining `log x` over `Real(x)`, then restricting scalars to `Real`,
is exactly the previously defined field `F0 = Real(x, log x)`. -/
theorem adjoin_logX_restrictScalars_eq_F0 :
    (IntermediateField.adjoin realXField
        ({OneVariableBaseField.logX} : Set A)).restrictScalars Real =
      OneVariableBaseField.F0.toIntermediateField := by
  change
    (IntermediateField.adjoin
        (IntermediateField.adjoin Real
          ({OneVariableBaseField.x} : Set A))
        ({OneVariableBaseField.logX} : Set A)).restrictScalars Real =
      IntermediateField.adjoin Real OneVariableBaseField.generators
  rw [IntermediateField.adjoin_adjoin_left]
  congr 1

/-- Carrier-level form of `adjoin_logX_restrictScalars_eq_F0`. -/
theorem mem_adjoin_logX_iff_mem_F0 (y : A) :
    y ∈ IntermediateField.adjoin realXField
        ({OneVariableBaseField.logX} : Set A) ↔
      y ∈ OneVariableBaseField.F0 := by
  change y ∈
      (IntermediateField.adjoin realXField
        ({OneVariableBaseField.logX} : Set A)).restrictScalars Real ↔ _
  rw [adjoin_logX_restrictScalars_eq_F0]
  rfl

/-! ## The logarithmic generator over `Real(x)` -/

/-- Algebraic independence of `(x, log x)` implies that `log x` is
transcendental over `Real(x)`. -/
theorem logX_transcendental_over_realXField :
    Transcendental realXField OneVariableBaseField.logX := by
  have h := OneVariableBaseField.x_logX_algebraicIndependent.transcendental_adjoin
    (s := ({0} : Set (Fin 2))) (i := (1 : Fin 2)) (by simp)
  have himage :
      (![OneVariableBaseField.x, OneVariableBaseField.logX] : Fin 2 → A) ''
          ({0} : Set (Fin 2)) = {OneVariableBaseField.x} := by
    ext y
    simp
  have h' :
      Transcendental
        (IntermediateField.adjoin Real
          ((![OneVariableBaseField.x, OneVariableBaseField.logX] : Fin 2 → A) ''
            ({0} : Set (Fin 2))))
        OneVariableBaseField.logX :=
    (IntermediateField.transcendental_adjoin_iff).2 h
  rw [himage] at h'
  have hcomp :
      RingHom.comp (algebraMap realXField A)
          realXFieldEquivUnderlying.toRingHom =
        RingHom.comp (RingHom.id A)
          (algebraMap
            (IntermediateField.adjoin Real
              ({OneVariableBaseField.x} : Set A)) A) := by
    ext y
    rfl
  exact ((transcendental_ringHom_iff_of_comp_eq
    realXFieldEquivUnderlying (RingHom.id A)
    Function.injective_id hcomp).2 h')

/-- The exact primitive differential equation for `log x` over `Real(x)`. -/
theorem deriv_logX_eq_logDeriv_xGen :
    OneVariableBaseField.logX′ =
      algebraMap realXField A (xGen′ / xGen) := by
  rw [OneVariableBaseField.deriv_logX, deriv_xGen]
  simp

/-! ## Wilkie's base clause `(II)₀` -/

/-- The exact additional rigidity input used at the base logarithmic step:
constant slopes in logarithmic-derivative equations over `Real(x)` must be
integers. -/
abbrev RealXIntegralSlopeRigidity : Prop :=
  Proposition31II.IntegralSlopeRigidity xGen

/-- Nested-adjoin form of Wilkie's one-variable base clause `(II)₀`.

The invocation of Proposition 3.1(ii) is exactly
`simpleAdjoin_proposition31_ii_of_integralSlopeRigidity`; its extra
`IntegralSlopeRigidity` premise is displayed rather than hidden.  The
remaining coefficient equation is discharged by the seed classification
for `Real(x)`.
-/
theorem nestedAdjoin_solution_classification_of_integralSlopeRigidity
    (hrigid : RealXIntegralSlopeRigidity)
    (X Y : IntermediateField.adjoin realXField
      ({OneVariableBaseField.logX} : Set A))
    (hX0 : (X : A) ≠ 0)
    (heq : ((X : A))′ = ((Y : A))′ * (X : A)) :
    ∃ m : Int, ∃ c d : Real, c ≠ 0 ∧
      (X : A) = algebraMap Real A c * OneVariableBaseField.x ^ m ∧
      (Y : A) = (m : A) * OneVariableBaseField.logX +
        algebraMap Real A d := by
  obtain ⟨m, w, v, hw0, hXw, hYv, hw⟩ :=
    Proposition31II.simpleAdjoin_proposition31_ii_of_integralSlopeRigidity
      xGen xGen_ne_zero hrigid
      OneVariableBaseField.logX logX_transcendental_over_realXField
      deriv_logX_eq_logDeriv_xGen X Y hX0 heq
  let wX : IntermediateField.adjoin Real
      ({OneVariableBaseField.x} : Set A) :=
    ⟨(w : A), by simpa [realXField] using w.2⟩
  let vX : IntermediateField.adjoin Real
      ({OneVariableBaseField.x} : Set A) :=
    ⟨(v : A), by simpa [realXField] using v.2⟩
  have hwX0 : (wX : A) ≠ 0 := by
    intro hzero
    apply hw0
    apply Subtype.ext
    exact hzero
  have hwAmbient : ((wX : A))′ = ((vX : A))′ * (wX : A) := by
    simpa [wX, vX] using congrArg Subtype.val hw
  obtain ⟨c, d, hc0, hwc, hvd⟩ :=
    BaseRationalClassification.analyticX_simpleAdjoin_classification
      wX vX hwX0 hwAmbient
  have hwc' : (w : A) = algebraMap Real A c := by
    simpa [wX] using hwc
  have hvd' : (v : A) = algebraMap Real A d := by
    simpa [vX] using hvd
  refine ⟨m, c, d, hc0, ?_, ?_⟩
  · calc
      (X : A) = algebraMap realXField A (xGen ^ m * w) := hXw
      _ = OneVariableBaseField.x ^ m * (w : A) := by
        rw [map_mul, map_zpow₀]
        rfl
      _ = algebraMap Real A c * OneVariableBaseField.x ^ m := by
        rw [hwc']
        ring
  · calc
      (Y : A) = algebraMap realXField A (m : realXField) *
          OneVariableBaseField.logX + algebraMap realXField A v := hYv
      _ = (m : A) * OneVariableBaseField.logX + (v : A) := by simp
      _ = (m : A) * OneVariableBaseField.logX +
          algebraMap Real A d := by rw [hvd']

/-- Wilkie's base clause `(II)₀` in the existing bundled field
`F0 = Real(x, log x)`.  Only `X` needs to be nonzero; thus this is slightly
stronger than a formulation that also assumes `Y ≠ 0`.

The conclusion gives both parts of the classification: the multiplicative
coordinate is a nonzero real multiple of an integral power of `x`, and its
primitive is affine in `log x` with the same integral slope.
-/
theorem F0_solution_classification_of_integralSlopeRigidity
    (hrigid : RealXIntegralSlopeRigidity)
    (X Y : OneVariableBaseField.F0)
    (hX0 : X ≠ 0)
    (heq : X′ = Y′ * X) :
    ∃ m : Int, ∃ c d : Real, c ≠ 0 ∧
      (X : A) = algebraMap Real A c * OneVariableBaseField.x ^ m ∧
      (Y : A) = (m : A) * OneVariableBaseField.logX +
        algebraMap Real A d := by
  let Xnested : IntermediateField.adjoin realXField
      ({OneVariableBaseField.logX} : Set A) :=
    ⟨(X : A), (mem_adjoin_logX_iff_mem_F0 (X : A)).2 X.2⟩
  let Ynested : IntermediateField.adjoin realXField
      ({OneVariableBaseField.logX} : Set A) :=
    ⟨(Y : A), (mem_adjoin_logX_iff_mem_F0 (Y : A)).2 Y.2⟩
  have hXnested0 : (Xnested : A) ≠ 0 := by
    intro hzero
    apply hX0
    apply Subtype.ext
    exact hzero
  have heqAmbient :
      ((Xnested : A))′ = ((Ynested : A))′ * (Xnested : A) := by
    simpa [Xnested, Ynested] using congrArg Subtype.val heq
  simpa [Xnested, Ynested] using
    nestedAdjoin_solution_classification_of_integralSlopeRigidity
      hrigid Xnested Ynested hXnested0 heqAmbient

end

end Natfunbasis.Wilkie.BaseFieldClassification
