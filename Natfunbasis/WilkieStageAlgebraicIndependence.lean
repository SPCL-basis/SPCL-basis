import Natfunbasis.WilkieFiniteStageFields
import Natfunbasis.WilkieOneVariableBaseIndependence
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
# Algebraic-independence bookkeeping for Wilkie's finite stages

This file records the generator sets underlying the differential fields in
`WilkieFiniteStageFields`.  Stage zero is generated by `x` and `log x`.  At
stage `n`, the logarithm of the current base is inserted exactly when that
base is fresh, and the current power generator is then inserted.

The main results identify the underlying intermediate fields with the fields
adjoined by these sets and isolate the two transcendence hypotheses needed
for an algebraically independent successor step.  No such transcendence
hypothesis is proved here; this is bookkeeping for the induction in Wilkie's
Theorem 4.4, not a proof of that theorem.
-/

namespace Natfunbasis.Wilkie

open Set
open scoped Differential

noncomputable section

local notation "A" => PositiveAnalyticFunction
local notation "K" => PositiveAnalyticFractionField
local notation "ι" => (algebraMap A K)

namespace GeneratorSequence

variable {D : PolynomialDerivability} (S : GeneratorSequence D)

/-! ## Recursive ambient generator sets -/

/-- The ambient generators present after the first `n` power stages.

At a successor, the optional fresh logarithm is inserted first and the
current power generator is inserted second. -/
def stageGenerators : Nat → Set K
  | 0 => {OneVariableBaseField.x, OneVariableBaseField.logX}
  | n + 1 => by
      classical
      exact
        insert (ι (S.realTauAnalyticFunction n))
          (if S.IsFreshBase n then
            insert (ι (S.logBaseAnalytic n)) (stageGenerators n)
          else
            stageGenerators n)

/-- The generators immediately after the optional logarithm step and before
adjoining the current power generator. -/
def beforeTauGenerators (n : Nat) : Set K :=
  by
    classical
    exact if S.IsFreshBase n then
      insert (ι (S.logBaseAnalytic n)) (S.stageGenerators n)
    else
      S.stageGenerators n

@[simp]
theorem stageGenerators_zero :
    S.stageGenerators 0 =
      {OneVariableBaseField.x, OneVariableBaseField.logX} :=
  rfl

@[simp]
theorem stageGenerators_succ (n : Nat) :
    S.stageGenerators (n + 1) =
      insert (ι (S.realTauAnalyticFunction n))
        (S.beforeTauGenerators n) :=
  rfl

theorem beforeTauGenerators_eq_of_fresh {n : Nat}
    (hfresh : S.IsFreshBase n) :
    S.beforeTauGenerators n =
      insert (ι (S.logBaseAnalytic n)) (S.stageGenerators n) := by
  simp [beforeTauGenerators, hfresh]

theorem beforeTauGenerators_eq_of_not_fresh {n : Nat}
    (hfresh : ¬ S.IsFreshBase n) :
    S.beforeTauGenerators n = S.stageGenerators n := by
  simp [beforeTauGenerators, hfresh]

/-! ## Identification of the recursively constructed fields -/

/-- The underlying ordinary intermediate field of an adjunction, with every
instance in the three-field tower supplied explicitly.  This wrapper avoids
ambiguous typeclass search when the middle field is itself a subtype. -/
private def restrictScalarsAdjoin
    (F : DifferentialIntermediateField Real K) (t : Set K) :
    IntermediateField Real K :=
  @IntermediateField.restrictScalars Real K F.toIntermediateField
    (inferInstance : Field Real)
    (inferInstance : Field K)
    (IntermediateField.toField F.toIntermediateField)
    (inferInstance : Algebra Real K)
    (IntermediateField.algebra' F.toIntermediateField)
    (IntermediateField.toAlgebra F.toIntermediateField)
    (IntermediateField.isScalarTower_mid' F.toIntermediateField)
    (@IntermediateField.adjoin F.toIntermediateField
      (IntermediateField.toField F.toIntermediateField) K
      (inferInstance : Field K)
      (IntermediateField.toAlgebra F.toIntermediateField) t)

private theorem adjoinOver_toIntermediateField_eq_restrictScalarsAdjoin
    (F : DifferentialIntermediateField Real K) (t : Set K)
    (hgenerator : ∀ x ∈ t,
      x′ ∈ IntermediateField.adjoin F.toIntermediateField t) :
    (F.adjoinOver t hgenerator).toIntermediateField =
      restrictScalarsAdjoin F t :=
  rfl

private theorem restrictScalars_adjoin_singleton_eq
    (F : DifferentialIntermediateField Real K) (s : Set K) (z : K)
    (hF : F.toIntermediateField = IntermediateField.adjoin Real s) :
    restrictScalarsAdjoin F {z} =
      IntermediateField.adjoin Real (insert z s) := by
  unfold restrictScalarsAdjoin
  apply le_antisymm
  · intro y hy
    change y ∈ IntermediateField.adjoin F.toIntermediateField {z} at hy
    induction hy using IntermediateField.adjoin_induction with
    | mem y hy =>
        have hyz : y = z := by simpa using hy
        subst y
        exact IntermediateField.subset_adjoin Real (insert z s) (by simp)
    | algebraMap c =>
        have hc : (c : K) ∈ IntermediateField.adjoin Real s := by
          exact hF.le c.2
        exact (IntermediateField.adjoin.mono Real s (insert z s)
          (Set.subset_insert z s)) hc
    | add _ _ _ _ hx hy => exact add_mem hx hy
    | inv _ _ hx => exact inv_mem hx
    | mul _ _ _ _ hx hy => exact mul_mem hx hy
  · apply IntermediateField.adjoin_le_iff.mpr
    intro y hy
    change y ∈ IntermediateField.adjoin F.toIntermediateField {z}
    rcases Set.mem_insert_iff.mp hy with hyz | hy
    · subst y
      exact IntermediateField.subset_adjoin F.toIntermediateField {z}
        (Set.mem_singleton z)
    · have hyF : y ∈ F.toIntermediateField :=
        hF.ge (IntermediateField.subset_adjoin Real s hy)
      let yF : F.toIntermediateField := ⟨y, hyF⟩
      exact IntermediateField.algebraMap_mem
        (IntermediateField.adjoin F.toIntermediateField {z}) yF

private theorem finiteStage_fields_eq_adjoin : ∀ n : Nat,
    ((S.finiteStageField n).toIntermediateField =
        IntermediateField.adjoin Real (S.stageGenerators n)) ∧
      ((S.finiteStageBeforeTau n).toIntermediateField =
        IntermediateField.adjoin Real (S.beforeTauGenerators n)) := by
  intro n
  induction n with
  | zero =>
      have hfield :
          (S.finiteStageField 0).toIntermediateField =
            IntermediateField.adjoin Real (S.stageGenerators 0) := by
        rfl
      refine ⟨hfield, ?_⟩
      classical
      by_cases hfresh : S.IsFreshBase 0
      · change
          ((S.differentialStage 0).beforeTau).toIntermediateField =
            IntermediateField.adjoin Real (S.beforeTauGenerators 0)
        rw [DifferentialStage.beforeTau, dif_pos hfresh,
          beforeTauGenerators_eq_of_fresh S hfresh]
        rw [adjoinOver_toIntermediateField_eq_restrictScalarsAdjoin]
        exact restrictScalars_adjoin_singleton_eq
          (S.differentialStage 0).field
          (S.stageGenerators 0)
          (ι (S.logBaseAnalytic 0)) hfield
      · change
          ((S.differentialStage 0).beforeTau).toIntermediateField =
            IntermediateField.adjoin Real (S.beforeTauGenerators 0)
        rw [DifferentialStage.beforeTau, dif_neg hfresh,
          beforeTauGenerators_eq_of_not_fresh S hfresh]
        exact hfield
  | succ n ih =>
      have hfield :
          (S.finiteStageField (n + 1)).toIntermediateField =
            IntermediateField.adjoin Real (S.stageGenerators (n + 1)) := by
        change
          ((S.differentialStage n).nextField).toIntermediateField =
            IntermediateField.adjoin Real (S.stageGenerators (n + 1))
        rw [DifferentialStage.nextField,
          adjoinOver_toIntermediateField_eq_restrictScalarsAdjoin,
          stageGenerators_succ]
        exact restrictScalars_adjoin_singleton_eq
          ((S.differentialStage n).beforeTau)
          (S.beforeTauGenerators n)
          (ι (S.realTauAnalyticFunction n)) ih.2
      refine ⟨hfield, ?_⟩
      classical
      by_cases hfresh : S.IsFreshBase (n + 1)
      · change
          ((S.differentialStage (n + 1)).beforeTau).toIntermediateField =
            IntermediateField.adjoin Real (S.beforeTauGenerators (n + 1))
        rw [DifferentialStage.beforeTau, dif_pos hfresh,
          beforeTauGenerators_eq_of_fresh S hfresh,
          adjoinOver_toIntermediateField_eq_restrictScalarsAdjoin]
        exact restrictScalars_adjoin_singleton_eq
          (S.differentialStage (n + 1)).field
          (S.stageGenerators (n + 1))
          (ι (S.logBaseAnalytic (n + 1))) hfield
      · change
          ((S.differentialStage (n + 1)).beforeTau).toIntermediateField =
            IntermediateField.adjoin Real (S.beforeTauGenerators (n + 1))
        rw [DifferentialStage.beforeTau, dif_neg hfresh,
          beforeTauGenerators_eq_of_not_fresh S hfresh]
        exact hfield

/-- The underlying field of the completed `n`-th stage is exactly the field
generated over `Real` by `stageGenerators n`. -/
theorem finiteStageField_toIntermediateField_eq_adjoin (n : Nat) :
    (S.finiteStageField n).toIntermediateField =
      IntermediateField.adjoin Real (S.stageGenerators n) :=
  (finiteStage_fields_eq_adjoin S n).1

/-- The underlying field immediately before adjoining `tau_n` is exactly the
field generated by `beforeTauGenerators n`. -/
theorem finiteStageBeforeTau_toIntermediateField_eq_adjoin (n : Nat) :
    (S.finiteStageBeforeTau n).toIntermediateField =
      IntermediateField.adjoin Real (S.beforeTauGenerators n) :=
  (finiteStage_fields_eq_adjoin S n).2

/-! ## Algebraic-independence induction -/

/-- The stage-zero generator set `{x, log x}` is algebraically independent
over the real constants. -/
theorem algebraicIndepOn_stageGenerators_zero :
    AlgebraicIndepOn Real id (S.stageGenerators 0) := by
  have h := OneVariableBaseField.x_logX_algebraicIndependent.coe_range
  change AlgebraicIndependent Real
    ((↑) : S.stageGenerators 0 → K)
  have hrange :
      Set.range (![OneVariableBaseField.x, OneVariableBaseField.logX] :
        Fin 2 → K) = S.stageGenerators 0 := by
    ext z
    simp [stageGenerators, or_comm]
  rw [← hrange]
  exact h

/-- Algebraic independence survives the optional logarithm step provided
that a fresh logarithm is transcendental over the old finite-stage field.
No logarithmic hypothesis is requested when the current base is not fresh. -/
theorem algebraicIndepOn_beforeTauGenerators {n : Nat}
    (hstage : AlgebraicIndepOn Real id (S.stageGenerators n))
    (hlog : S.IsFreshBase n →
      Transcendental (S.finiteStageField n).toIntermediateField
        (ι (S.logBaseAnalytic n))) :
    AlgebraicIndepOn Real id (S.beforeTauGenerators n) := by
  classical
  by_cases hfresh : S.IsFreshBase n
  · rw [beforeTauGenerators_eq_of_fresh S hfresh]
    apply hstage.insert
    have ht := hlog hfresh
    rw [finiteStageField_toIntermediateField_eq_adjoin S n] at ht
    have ht' :=
      (IntermediateField.transcendental_adjoin_iff
        (F := Real) (s := S.stageGenerators n)
        (x := ι (S.logBaseAnalytic n))).mp ht
    change Transcendental
      (Algebra.adjoin Real ((id : K → K) '' S.stageGenerators n))
      (ι (S.logBaseAnalytic n))
    rw [Set.image_id]
    exact ht'
  · simpa [beforeTauGenerators, hfresh] using hstage

/-- One full successor step for the generator-set independence invariant.

The fresh-logarithm hypothesis is conditional on freshness.  The power
generator is required to be transcendental over the actual pre-`tau` field,
which already includes the logarithm exactly in the fresh case. -/
theorem algebraicIndepOn_stageGenerators_succ {n : Nat}
    (hstage : AlgebraicIndepOn Real id (S.stageGenerators n))
    (hlog : S.IsFreshBase n →
      Transcendental (S.finiteStageField n).toIntermediateField
        (ι (S.logBaseAnalytic n)))
    (htau : Transcendental (S.finiteStageBeforeTau n).toIntermediateField
      (ι (S.realTauAnalyticFunction n))) :
    AlgebraicIndepOn Real id (S.stageGenerators (n + 1)) := by
  rw [stageGenerators_succ]
  apply (S.algebraicIndepOn_beforeTauGenerators hstage hlog).insert
  rw [finiteStageBeforeTau_toIntermediateField_eq_adjoin S n] at htau
  have htau' :=
    (IntermediateField.transcendental_adjoin_iff
      (F := Real) (s := S.beforeTauGenerators n)
      (x := ι (S.realTauAnalyticFunction n))).mp htau
  change Transcendental
    (Algebra.adjoin Real ((id : K → K) '' S.beforeTauGenerators n))
    (ι (S.realTauAnalyticFunction n))
  rw [Set.image_id]
  exact htau'

/-- Iterating the two local transcendence inputs gives algebraic
independence of every finite generator stage. -/
theorem algebraicIndepOn_stageGenerators_of_transcendence
    (hlog : ∀ n, S.IsFreshBase n →
      Transcendental (S.finiteStageField n).toIntermediateField
        (ι (S.logBaseAnalytic n)))
    (htau : ∀ n,
      Transcendental (S.finiteStageBeforeTau n).toIntermediateField
        (ι (S.realTauAnalyticFunction n))) :
    ∀ n, AlgebraicIndepOn Real id (S.stageGenerators n)
  | 0 => S.algebraicIndepOn_stageGenerators_zero
  | n + 1 => S.algebraicIndepOn_stageGenerators_succ
      (algebraicIndepOn_stageGenerators_of_transcendence hlog htau n)
      (hlog n) (htau n)

end GeneratorSequence

end

end Natfunbasis.Wilkie
